{
  "manifest_version": 3,
  "name": "Last.fm Warmup",
  "description": "Automatically visit /home before visiting other Last.fm pages.",
  "version": "1.0.0",

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://www.last.fm/*"
  ],

  "background": {
    "service_worker": "background.js"
  }
}
